{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "iterm2",
  "version": "0.1.0",
  "description": "Open background iTerm2 tabs in the intended window and group.",
  "author": {
    "name": "Kyle Purdon"
  },
  "repository": "https://github.com/kpurdon/iterm2",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "iterm2",
        "shortDescription": "New tabs with reliable grouping",
        "defaultPrompt": [
          "Use $tabs to open a background iTerm2 tab in this project group."
        ]
      }
    }
  }
}
